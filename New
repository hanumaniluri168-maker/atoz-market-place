
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>A TO Z MARKET PLACE</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090909;color:#fff;font-family:Arial,sans-serif}
header{padding:20px;background:#111;border-bottom:2px solid #d6ad55;text-align:center}
h1{color:#e4bd68}
nav{padding:15px;text-align:center}
input{padding:12px;border-radius:6px;border:1px solid #d6ad55;background:#222;color:white}
button{padding:11px 18px;background:#d6ad55;border:0;border-radius:6px;font-weight:bold;cursor:pointer}
.hero{text-align:center;padding:65px 15px;background:linear-gradient(120deg,#29200e,#090909)}
.hero h2{font-size:38px}
.gold{color:#e4bd68}
.container{padding:25px;max-width:1100px;margin:auto}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px}
.card{background:#191919;border:1px solid #5b4725;border-radius:10px;padding:18px;text-align:center}
.emoji{font-size:55px}
.price{color:#e4bd68;font-weight:bold;font-size:20px}
.cart{background:#191919;padding:20px;margin-top:25px;border-radius:10px}
footer{text-align:center;padding:30px;color:#aaa;border-top:1px solid #d6ad55}
</style>
</head>
<body>
<header>
<h1>A TO Z MARKET PLACE</h1>
<p>Everything you need, all in one place.</p>
</header>

<section class="hero">
<h2>Welcome to <span class="gold">A TO Z</span></h2>
<p>Discover amazing products at great prices.</p>
<button onclick="document.getElementById('shop').scrollIntoView()">SHOP NOW</button>
</section>

<div class="container" id="shop">
<h2 class="gold">Our Product Catalogue</h2>
<input id="search" placeholder="Search products..." oninput="render()">
<div class="filters" id="filters"></div>
<div class="products" id="products"></div>

<div class="cart">
<h2 class="gold">Shopping Cart</h2>
<div id="cart"></div>
<h3 id="total">Total: ₹0</h3>
<button onclick="alert('Online checkout will be available after payment gateway setup.')">Checkout</button>
</div>
</div>

<footer>
<p>© 2026 A TO Z MARKET PLACE</p>
<p>Premium Shopping Experience</p>
</footer>

<script>
let items=[
{name:"Fashion Sneakers",price:1499,cat:"Fashion",emoji:"👟"},
{name:"Wireless Headphones",price:2199,cat:"Electronics",emoji:"🎧"},
{name:"Smart Watch",price:1799,cat:"Electronics",emoji:"⌚"},
{name:"Premium Backpack",price:999,cat:"Fashion",emoji:"🎒"},
{name:"Table Lamp",price:899,cat:"Home",emoji:"💡"},
{name:"Skincare Kit",price:1299,cat:"Beauty",emoji:"🧴"},
{name:"Coffee Mug",price:349,cat:"Home",emoji:"☕"},
{name:"Chocolate Box",price:599,cat:"Food",emoji:"🍫"}
];
let cart={};
let category="All";

function render(){
let categories=["All","Fashion","Electronics","Home","Beauty","Food"];
document.getElementById("filters").innerHTML=categories.map(c=>
`<button onclick="category='${c}';render()">${c}</button>`).join("");

let search=document.getElementById("search").value.toLowerCase();
let filtered=items.filter(p=>
(category==="All"||p.cat===category)&&p.name.toLowerCase().includes(search));

document.getElementById("products").innerHTML=filtered.map((p,i)=>
`<div class="card">
<div class="emoji">${p.emoji}</div>
<h3>${p.name}</h3>
<p>${p.cat}</p>
<p class="price">₹${p.price}</p>
<button onclick="add('${p.name}')">Add to Cart</button>
</div>`).join("")||"No products found";

showCart();
}

function add(name){
cart[name]=(cart[name]||0)+1;
showCart();
}

function showCart(){
let total=0;
document.getElementById("cart").innerHTML=
Object.entries(cart).map(([name,qty])=>{
let p=items.find(x=>x.name===name);
if(!p)return "";
total+=p.price*qty;
return `<p>${name} × ${qty} — ₹${p.price*qty}
<button onclick="cart['${name}']--;if(cart['${name}']<=0)delete cart['${name}'];showCart()">-</button></p>`;
}).join("")||"Your cart is empty";
document.getElementById("total").innerText="Total: ₹"+total;
}
render();
</script>
</body>
</html>
